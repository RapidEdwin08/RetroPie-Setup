--- a/src/borked3ds_qt/gamepad_cursor.h	Source-gvx64-a7095a7a
+++ b/src/borked3ds_qt/gamepad_cursor.h	Gamepad-Cursor-DTEAM-1-b298f856
@@ -0,0 +1,108 @@
+// Copyright 2026 Borked3DS Emulator Project

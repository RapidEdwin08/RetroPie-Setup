+    QPoint last_press_pos;
+
+    bool gamepad_moved_pointer = false; // the pointer was last moved by the stick
+    bool hidden = false;                // override cursor (blank) installed by us
+    bool was_in_game = false;
+    QPoint last_warp_pos;
+};
